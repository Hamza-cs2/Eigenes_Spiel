; Engine configuration file.
config_version=5

[application]

config/name="Relic Keep"
config/description="Dead-Cells-like roguelike with relic defense rooms and permadeath."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://resources/ui_theme.tres"

[input]

move_left={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventKey,"device":-1,"physical_keycode":4194319), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventKey,"device":-1,"physical_keycode":4194321), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
move_down={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventKey,"device":-1,"physical_keycode":4194322), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
jump={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventKey,"device":-1,"physical_keycode":4194320), Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":true)]
}
dash={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventKey,"device":-1,"physical_keycode":76), Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":true)]
}
attack={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":74), Object(InputEventMouseButton,"device":-1,"button_index":1,"pressed":true), Object(InputEventJoypadButton,"device":-1,"button_index":2,"pressed":true)]
}
interact={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69), Object(InputEventJoypadButton,"device":-1,"button_index":3,"pressed":true)]
}
pause={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":6,"pressed":true)]
}
toggle_fullscreen={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194342)]
}
map={
"deadzone": 0.3,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":77), Object(InputEventKey,"device":-1,"physical_keycode":4194306), Object(InputEventJoypadButton,"device":-1,"button_index":4,"pressed":true)]
}

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="PlayerAttack"
2d_physics/layer_5="EnemyAttack"
2d_physics/layer_6="Pickups"
2d_physics/layer_7="Platforms"
2d_physics/layer_8="Ledges"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
